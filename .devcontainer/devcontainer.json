{
  "name": "博客 Jekyll 预览",
  "image": "mcr.microsoft.com/devcontainers/ruby:3.3-bookworm",
  "postCreateCommand": "bundle install",
  "postStartCommand": "bundle exec jekyll serve --host 0.0.0.0 --port 4000 --detach",
  "forwardPorts": [4000],
  "portsAttributes": {
    "4000": {
      "label": "博客预览",
      "onAutoForward": "openBrowser"
    }
  }
}
